# — LLM provider (swappable; no provider or model is assumed, set both)
LLM_PROVIDER=groq            # gemini | groq
LLM_MODEL=your-model-id      # any model the chosen provider serves
GROQ_API_KEY=
GEMINI_API_KEY=              # only when LLM_PROVIDER=gemini
# GEMINI_BASE_URL=           # optional override

# — Hindsight Cloud (memory)
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=

# — Admin (required to enable DELETE /api/history/{customer_id})
ADMIN_API_KEY=

# — Optional
# AGENT_NAME=Support Assistant
# AGENT_PERSONA=You are a helpful, concise customer support agent.
# REQUEST_TIMEOUT_SECONDS=30
# MAX_RETRIES=2
# ANALYTICS_DB_PATH=data/analytics.sqlite3
# APP_ENV=development
