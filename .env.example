# LLM
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
GEMINI_API_KEY=your_google_ai_studio_key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional Groq fallback/alternate provider
GROQ_API_KEY=
GROQ_MODEL=

# Hindsight Cloud
HISTORY_PROVIDER=hindsight
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=your_hindsight_cloud_key

# Application
AGENT_NAME=Support Assistant
AGENT_PERSONA=You are a helpful, concise customer support agent.
REQUEST_TIMEOUT_SECONDS=30
MAX_RETRIES=2
ANALYTICS_DB_PATH=data/analytics.sqlite3
ADMIN_API_KEY=replace_with_a_long_random_admin_key
APP_ENV=development
